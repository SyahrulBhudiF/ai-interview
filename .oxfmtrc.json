{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "insertFinalNewline": true,
  "sortImports": true,
  "sortPackageJson": true,
  "sortTailwindcss": true,
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    ".turbo/**",
    ".output/**",
    ".devenv/**",
    "apps/**/dist/**",
    "apps/**/.output/**",
    "apps/web/src/routeTree.gen.ts",
    "bun.lock"
  ]
}
