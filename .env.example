# API
API_PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Optional tuning (defaults shown)
# API_IDLE_TIMEOUT_SECONDS=120
# API_MAX_REQUEST_BODY_BYTES=12582912
# GEMINI_TIMEOUT_MS=90000
# GEMINI_MODELS_TIMEOUT_MS=15000

# Google Gemini (required for AI interview features; add your key to run them)
GEMINI_API_KEY=

# Web (optional — the Vite proxy to the API is used by default in dev)
# VITE_API_URL=http://localhost:3001

# PostgreSQL (provided by `devenv up`)
DATABASE_URL=postgresql://ai_interview:ai_interview@127.0.0.1:5432/ai_interview
